# SkyGuard AI Database Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# Use a dedicated, least-privilege MySQL user (not root) in production.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=skyguard_app
MYSQL_PASSWORD=change-me-to-a-long-random-password
MYSQL_DATABASE=skyguard_db
    