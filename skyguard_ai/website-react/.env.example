# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Firebase web config is public by design. Protect the project instead with:
#   - Authentication → Settings → Authorized domains (only your real domains)
#   - API key restrictions (HTTP referrers / Android app) in Google Cloud Console
#   - App Check enforcement for Authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check (reCAPTCHA v3 site key). Leave empty to disable.
# Enable enforcement under Firebase Console → App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# CARTO basemaps key. Restrict allowed domains in the CARTO dashboard.
VITE_CARTO_KEY=

# Optional: EmailJS login alerts. Restrict allowed origins in the EmailJS
# dashboard so the public key cannot be abused from other sites.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
